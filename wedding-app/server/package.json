{
  "name": "wedding-app-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted Fastify + SQLite backend for the wedding venue app",
  "engines": {
    "node": ">=20.0.0 <23.0.0",
    "//": "Node 20 or 22 LTS. better-sqlite3 prebuilt binaries are LTS-only."
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "push:keys": "tsx scripts/generate-vapid-keys.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/jwt": "^10.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.2",
    "better-sqlite3": "^11.3.0",
    "fastify": "^5.8.5",
    "nodemailer": "^9.0.3",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.5.5",
    "@types/nodemailer": "^7.0.11",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.8",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^4.1.8"
  }
}