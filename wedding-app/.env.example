# Wedding Venue Intelligence Platform — environment variables
#
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
# Docker Compose reads `.env` automatically. For bare-metal runs, load it:
#   export $(grep -v '^#' .env | xargs)
#
# Generate secrets with:  openssl rand -hex 32

# ── REQUIRED in production (Docker Compose fails fast without these) ──
# JWT signing secret — at least 32 random bytes.
JWT_SECRET=
# AES-256-GCM master key for integration/webhook secrets. LOSING THIS KEY
# loses every stored credential — back it up like a database encryption key.
WEDDING_SECRETS_KEY=

# ── Server ─────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info
# Optional allowed CORS origin (same-origin production needs no setting).
# CORS_ORIGIN=https://yourwedding.example.com

# ── Storage ────────────────────────────────────────────────────────────
# SQLite database file location (Docker: /data/wedding.db)
# WEDDING_DB_PATH=/data/wedding.db
# Persistent directory for uploaded images and documents (Docker: /data/uploads)
# WEDDING_UPLOADS_PATH=/data/uploads

# ── Public app origin (payment checkout return URLs, portal links) ─────
# BASE_URL=https://yourwedding.example.com

# ── Security hardening ─────────────────────────────────────────────────
# Comma-separated proxy IPs/CIDRs trusted for X-Forwarded-For. Set when the
# app port is reachable directly so spoofed client IPs are ignored.
# TRUSTED_PROXIES=10.0.0.0/8
# Account lockout window after repeated failed logins (milliseconds).
LOGIN_LOCKOUT_MS=300000

# ── Retention (all report-only by default — nothing is deleted) ────────
# WEBHOOK_DELIVERY_RETENTION_DAYS=90
# AUDIT_RETENTION_DAYS=365

# ── Push notifications (WebPush VAPID) ─────────────────────────────────
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# ── Test ───────────────────────────────────────────────────────────────
# TEST_DB=:memory:
